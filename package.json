{
	"author": "Gery Hirschfeld <gery.hirschfeld@w3tec.ch> (https://github.com/hirsch88)",
	"bin": {
		"typeorm-seeding": "dist/cli.js"
	},
	"contributors": [
		"Jorge Bodega <jorge.bodega.f@gmail.com> (https://github.com/jorgebodega)"
	],
	"dependencies": {
		"commander": "14.0.3",
		"ora": "5.4.1",
		"tslib": "2.8.1"
	},
	"description": "🌱 A delightful way to seed test data into your database.",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@faker-js/faker": "10.6.0",
		"@jorgebodega/typeorm-factory": "4.0.0-next.1",
		"@swc/core": "1.16.13",
		"@swc/jest": "0.2.39",
		"@tsconfig/node24": "24.0.5",
		"@tsconfig/strictest": "2.0.8",
		"@types/jest": "30.0.0",
		"@types/node": "25.9.8",
		"better-sqlite3": "13.0.3",
		"jest": "30.5.2",
		"rimraf": "6.1.3",
		"ts-node": "10.9.2",
		"typeorm": "1.1.1",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.11.0"
	},
	"files": [
		"CHANGELOG.md",
		"dist"
	],
	"keywords": [
		"typeorm",
		"seed",
		"seeding",
		"orm"
	],
	"license": "MIT",
	"main": "dist/index.js",
	"name": "@jorgebodega/typeorm-seeding",
	"packageManager": "pnpm@12.8.2",
	"peerDependencies": {
		"typeorm": ">=1.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jorgebodega/typeorm-seeding.git"
	},
	"scripts": {
		"build": "tsc --project ./tsconfig.build.json",
		"checks": "pnpm format:ci && pnpm lint:ci && pnpm typecheck",
		"format:ci": "biome ci --assist-enabled=false --linter-enabled=false",
		"format": "biome format --write",
		"lint:ci": "biome ci --formatter-enabled=false",
		"lint:fix": "biome check --formatter-enabled=false --write",
		"lint": "biome check --formatter-enabled=false",
		"prebuild": "rimraf dist",
		"seed:run": "ts-node ./src/cli.ts seed",
		"test:ci": "jest --silent",
		"test:cov": "jest --coverage --silent",
		"test:watch": "jest --watch",
		"test": "jest",
		"typecheck": "tsc --noEmit"
	},
	"types": "dist/index.d.ts",
	"version": "9.0.0-next.2"
}
